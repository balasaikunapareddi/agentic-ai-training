# Copy to .env and fill in. Labs run in stub mode with no key at all;
# set GEMINI_API_KEY only for --live runs.
GEMINI_API_KEY=
# Model used by every lab (LiteLLM id). Change to swap provider/model.
LLM_MODEL=gemini/gemini-3.5-flash-lite
# Demo API key for the Day 3 production lab (local demo only).
TRAINING_API_KEY=training-demo-key
